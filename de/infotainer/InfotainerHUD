package de.infotainer;

import net.fabricmc.fabric.api.client.rendering.v1.HudRenderCallback;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.render.RenderTickCounter;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

public class InfotainerHud implements HudRenderCallback {
    private long lastSwitch=0; 
    private int mode=0;
    private final DateTimeFormatter timeFmt = DateTimeFormatter.ofPattern("HH:mm:ss | dd.MM.yyyy");

    @Override public void onHudRender(DrawContext ctx, RenderTickCounter t){
        var client = MinecraftClient.getInstance();
        if(client.options.hudHidden || client.world==null) return;
        
        long now = System.currentTimeMillis();
        if(now-lastSwitch>6500){ 
            mode=(mode+1)%4; 
            lastSwitch=now; 
            // Weniger Werbung wenn auf Grökingen
            if(InfotainerMod.SERVER_INFO.isGroekingen() && Math.random() < 0.7 && mode == 2) mode = 0;
            if(Math.random()<0.15) mode=2; 
        }

        int width = client.getWindow().getScaledWidth();
        int x = width-210; int y=5; int w=200; int h=58;
        
        // Hintergrund - Grökingen = dunkelgrün, sonst schwarz
        int bg = InfotainerMod.SERVER_INFO.isGroekingen() ? 0xCC0A2A12 : 0xCC000000;
        int accent = InfotainerMod.SERVER_INFO.isGroekingen() ? 0xFF2ECC71 : 0xFFFFAA00;
        
        ctx.fill(x,y,x+w,y+h,bg); 
        ctx.fill(x,y,x+w,y+2,accent);
        
        String l1="",l2="",l3="";
        boolean isGroek = InfotainerMod.SERVER_INFO.isGroekingen();
        
        switch(mode){
            case 0 -> { 
                var n=InfotainerMod.NEWS_MANAGER.getNext(); 
                l1="§e📰 "+n.source(); 
                l2=trunc(n.title(),30); 
                l3="§7via RSS"; 
            }
            case 1 -> { 
                if(isGroek) {
                    l1="§a✔ GRÖKINGEN";
                    l2="§f"+InfotainerMod.SERVER_INFO.getDisplayAddress();
                    l3="§7"+trunc(InfotainerMod.SERVER_INFO.getMotd(), 28);
                } else {
                    l1="§a🌐 "+InfotainerMod.SERVER_INFO.getDisplayAddress(); 
                    l2=trunc(InfotainerMod.SERVER_INFO.getMotd(),30); 
                    l3="§7"+client.getCurrentFps()+" FPS";
                }
            }
            case 2 -> { 
                if(isGroek) {
                    l1="§6§lGrökingen.de";
                    l2="§fDein Citybuild Server!";
                    l3="§7mc.grökingen.com";
                } else {
                    l1="§6§lInfotainer 1.0"; 
                    l2="§fStay informed!"; 
                    l3="§7modrinth.com/mod/infotainer"; 
                }
            }
            case 3 -> { 
                l1="§b🕒 "+LocalDateTime.now().format(timeFmt); 
                l2="§f"+client.player.getBlockPos().toShortString(); 
                l3=isGroek ? "§aGrökingen • "+client.getCurrentFps()+" FPS" : "§7"+client.getCurrentFps()+" FPS";
            }
        }
        
        // Favicon
        try{
            var srv = InfotainerMod.SERVER_INFO.getInfo();
            if(srv!=null && srv.getFavicon()!=null){
                ctx.drawTexture(srv.getFavicon(), x+5, y+8, 0,0,32,32,32,32);
            } else {
                // Fallback Icon für Grökingen
                ctx.fill(x+5,y+8,x+37,y+40, isGroek ? 0xFF2ECC71 : 0xFF333333);
                if(isGroek) ctx.drawText(client.textRenderer, "G", x+15, y+17, 0xFFFFFF, true);
            }
        }catch(Exception e){}

        ctx.drawText(client.textRenderer, l1, x+42, y+5, 0xFFFFFF, true);
        ctx.drawText(client.textRenderer, l2, x+42, y+17, 0xFFFFFF, true);
        ctx.drawText(client.textRenderer, l3, x+42, y+29, 0xAAAAAA, true);
    }
    private String trunc(String s,int len){ return s.length()<=len? s : s.substring(0,len-3)+"..."; }
}
